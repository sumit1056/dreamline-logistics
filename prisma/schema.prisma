// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @unique
  role          String   @default("DRIVER") // "FOUNDER", "DRIVER"
  passwordHash  String?
  passwordText  String?
  vehicleNumber String?
  salary        Int?
  loginEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Expense {
  id         Int      @id @default(autoincrement())
  amount     Float
  currency   String   @default("INR")
  category   String   // 'fuel', 'bittu', 'service', 'other', 'shadowfax', 'rate_change', 'factory', 'other_income'
  notes      String
  vehicle    String?
  senderName String
  timestamp  DateTime @default(now())
  approved   Boolean  @default(false)
  imageUrl   String?
  type       String   @default("EXPENSE") // "EXPENSE", "INCOME"
}

model AdminCredential {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Auto {
  id          Int      @id @default(autoincrement())
  plateNumber String   @unique
  modelName   String?
  ownerName   String?
  driverPhone String?
  createdAt   DateTime @default(now())
}

model TemporaryPass {
  id          Int      @id @default(autoincrement())
  passCode    String   @unique
  label       String?
  permission  String   @default("VIEW_ONLY") // "VIEW_ONLY", "FULL_EDIT"
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
}


